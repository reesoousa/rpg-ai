# Copie para .env e preencha. O .env NAO vai para o git.
#
# IMPORTANTE: aqui entram apenas chaves publicas por design.
# A service_role do Supabase e a chave do Gemini NUNCA entram neste arquivo —
# elas vivem como secrets das Edge Functions (supabase secrets set).

# Supabase — Project Settings > API
VITE_SUPABASE_URL=
# Chave anon / publishable (publica por design, protegida por RLS)
VITE_SUPABASE_ANON_KEY=

# Base path do build. GitHub Pages serve em /<repo>/.
# Para rodar na raiz (ex.: dominio proprio), use /
VITE_BASE_PATH=/rpg-ai/
